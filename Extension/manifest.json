{
  "manifest_version": 3,
  "name": "Formora — Web Personalization",
  "version": "0.1.0",
  "description": "Applies your personalization preferences to any webpage in real time.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Formora"
  },

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/dom-utils.js",
        "src/shared/config.js",
        "src/shared/storage.js",
        "src/transformations/typography.js",
        "src/transformations/spacing.js",
        "src/transformations/buttons.js",
        "src/transformations/navigation.js",
        "src/transformations/clutter.js",
        "src/transformations/images.js",
        "src/transformations/index.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "externally_connectable": {
    "matches": [
      "https://*.formora.app/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*"
    ]
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}